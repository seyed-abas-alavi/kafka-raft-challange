{
  "uid": "kafka-challenge-logs",
  "title": "Kafka Challenge - by Abas Alavi",
  "tags": ["kafka", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total sent by producer",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "queryType": "range",
          "expr": "sum(count_over_time({service=\"message-producer\"} |= \"[producer] sent\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0"
        },
        "overrides": []
      }
    },
