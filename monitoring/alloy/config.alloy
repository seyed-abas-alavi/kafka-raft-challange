// Grafana Alloy: collects the stdout/stderr of every container in this Compose
// project (kafka-1, kafka-2, message-producer, message-consumer, ...) and ships
// it to Loki. Each log line gets the labels: service, container.

discovery.docker "project" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=padvish-kafka"]
  }
}

discovery.relabel "project" {
  targets = []

  // Do not ship the logs of the monitoring stack itself.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "alloy|loki|grafana|volume-init"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "project" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.project.targets
  relabel_rules = discovery.relabel.project.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
